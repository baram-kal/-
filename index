<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>파산을 피해라! 대학생 생존게임</title>
<link href="https://fonts.googleapis.com/css2?family=Do+Hyeon&family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#EDF1F7;--card:#fff;--ink:#14213D;--mute:#5C6B85;--line:#D5DDEA;--pri:#1F3A8A;--onpri:#fff;--acc:#FFC933;--good:#12805C;--bad:#C93A3A;--tint:#F5F8FD;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0E1626;--card:#18233A;--ink:#EAF0FB;--mute:#9AABC8;--line:#2B3A57;--pri:#7FA2FF;--onpri:#0E1626;--good:#4FD3A0;--bad:#FF7A7A;--tint:#1C2942}}
:root[data-theme="dark"]{--bg:#0E1626;--card:#18233A;--ink:#EAF0FB;--mute:#9AABC8;--line:#2B3A57;--pri:#7FA2FF;--onpri:#0E1626;--good:#4FD3A0;--bad:#FF7A7A;--tint:#1C2942}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 'Noto Sans KR',system-ui,sans-serif}
#app{max-width:480px;margin:0 auto;padding:0 16px 48px}
h1,h2,.big{font-family:'Do Hyeon','Noto Sans KR',sans-serif;font-weight:400;letter-spacing:0}
h1{font-size:34px;line-height:1.2;margin:28px 0 8px}
h2{font-size:24px;margin:20px 0 8px}
p{margin:6px 0}.mute{color:var(--mute);font-size:14px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:16px;margin:12px 0}
.row{display:flex;justify-content:space-between;align-items:center;gap:10px;padding:8px 0;border-bottom:1px solid var(--line)}
.row:last-child{border-bottom:0}
.neg{color:var(--bad)}.pos{color:var(--good)}
button{font:inherit;font-weight:700;border:0;border-radius:10px;padding:12px 16px;background:var(--pri);color:var(--onpri);cursor:pointer;min-height:44px}
button.ghost{background:var(--tint);color:var(--ink);border:1px solid var(--line)}
button.w{width:100%;margin-top:10px}
button:disabled{opacity:.4;cursor:not-allowed}
button:focus-visible{outline:3px solid var(--acc);outline-offset:2px}
header{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--ink);color:var(--bg);margin:0 -16px;padding:12px 16px;display:grid;grid-template-columns:1fr auto;gap:6px 12px;align-items:center}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) header{background:#050B16;color:#EAF0FB}}
.bal small{display:block;opacity:.7;font-size:12px}
.bal b{font-family:'Do Hyeon',sans-serif;font-weight:400;font-size:32px;line-height:1.1}
header .neg{color:#FF8E8E}
.wk{display:flex;gap:6px;align-items:center;font-size:13px}
.wk i{width:22px;height:6px;border-radius:3px;background:rgba(255,255,255,.25)}
.wk i.d{background:var(--acc)}.wk i.c{background:#fff}
.sat{text-align:right;font-size:13px}.sat b{font-size:20px}
.ab{grid-column:1/3;background:rgba(255,255,255,.12);color:inherit;font-size:13px;padding:8px 12px;min-height:40px;text-align:left}
.ab.on{background:var(--acc);color:#14213D}
.tag{display:inline-block;font-size:12px;padding:1px 8px;border-radius:99px;border:1px solid var(--line);color:var(--mute);margin-right:6px}
.opt{display:block;width:100%;text-align:left;background:var(--tint);color:var(--ink);border:1px solid var(--line);margin-top:8px;font-weight:500}
.opt.sel{border-color:var(--pri);box-shadow:inset 0 0 0 2px var(--pri)}
.opt.ok{border-color:var(--good);box-shadow:inset 0 0 0 2px var(--good)}
.opt.no{border-color:var(--bad);box-shadow:inset 0 0 0 2px var(--bad)}
.die{font-family:'Do Hyeon';font-size:64px;text-align:center;line-height:1.3}
.stamp{display:inline-block;border:4px solid var(--bad);color:var(--bad);font-family:'Do Hyeon';font-size:40px;padding:2px 18px;border-radius:8px;transform:rotate(-6deg)}
.stamp.ok{border-color:var(--good);color:var(--good)}
.bar{height:8px;border-radius:4px;background:var(--line);overflow:hidden}.bar>i{display:block;height:100%;background:var(--bad)}
textarea{width:100%;font:inherit;padding:10px;border-radius:10px;border:1px solid var(--line);background:var(--tint);color:var(--ink)}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:10px 16px;border-radius:10px;font-size:14px;z-index:9;max-width:90%}
@media (prefers-reduced-motion:no-preference){.stamp{animation:st .35s ease-out}@keyframes st{from{transform:rotate(-6deg) scale(2);opacity:0}}}
</style>
</head>
<body>
<div id="app"></div>
<script>
const SIT=[
{n:'자취생',inc:60000,fx:50000,b:4,d:'월세분 30,000 + 식비·공과금 20,000'},
{n:'통학생',inc:55000,fx:35000,b:0,d:'교통 15,000 + 식비 20,000'},
{n:'장학생(자취)',inc:70000,fx:50000,b:0,d:'월세분 30,000 + 식비·공과금 20,000'},
{n:'학자금대출 상환자(통학)',inc:60000,fx:45000,b:2,d:'교통·식비 30,000 + 대출 상환 15,000'}];
const TEAMS=[
{n:'자취생',inc:60000,fx:50000,b:4,d:'월세분 30,000 + 식비·공과금 20,000',ab:{n:'김꼼꼼',t:'d',d:'소비 항목 1개를 최대 30,000원 할인'}},
{n:'통학생',inc:55000,fx:35000,b:0,d:'교통 15,000 + 식비 20,000',ab:{n:'박알바',t:'b',d:'QR 미션 성공 시 보너스 +30,000원'}},
{n:'장학생(자취)',inc:70000,fx:50000,b:0,d:'월세분 30,000 + 식비·공과금 20,000',ab:{n:'최세이브',t:'s',d:'돌발 지출 합계에서 최대 30,000원 면제'}},
{n:'학자금대출 상환자(통학)',inc:60000,fx:45000,b:2,d:'교통·식비 30,000 + 대출 상환 15,000',ab:{n:'이플렉스',t:'f',d:'구매 항목 1개 만족도 +5점'}},
{n:'기숙사생',inc:60000,fx:45000,b:2,d:'기숙사비 25,000 + 식비 20,000',ab:{n:'한구독',t:'g',d:'구독 서비스 비용 전액 면제 (최대 30,000원)'}}];
const CH=[
{n:'김꼼꼼',t:'d',d:'소비 항목 1개를 최대 30,000원 할인'},
{n:'박알바',t:'b',d:'QR 미션 성공 시 보너스 +30,000원'},
{n:'이플렉스',t:'f',d:'구매 항목 1개 만족도 +5점'},
{n:'최세이브',t:'s',d:'돌발 지출 합계에서 최대 30,000원 면제'},
{n:'한구독',t:'g',d:'구독 서비스 비용 전액 면제 (최대 30,000원)'}];
const EV=[[-10000,'친구 경조사'],[-8000,'자전거 타이어 펑크'],[-5000,'감기로 병원 방문'],[-3000,'휴대전화 요금 연체 가산'],[5000,'중고 거래 성공'],[3000,'본가에서 반찬이 옴'],[3000,'교내 근로 추가 근무'],[0,'아무 일 없는 주'],[0,'아무 일 없는 주'],[0,'아무 일 없는 주']];
const SAVE={id:'save',n:'비상금 저축',p:10000,s:1,k:'선택',note:'다음 정산 때 11,000원 환급(이자 10%)'};
const ITEMS={
1:[{id:'bookN',g:'book',n:'전공 교재 (새 책)',p:20000,s:0,k:'필수'},{id:'bookU',g:'book',n:'전공 교재 (중고)',p:12000,s:0,k:'필수'},
{id:'ott',n:'OTT 구독',p:10000,s:3,k:'선택',note:'가입하면 매주 10,000원 자동 결제, 다음 주부터 만족도 +1. 주 시작 때 해지 가능'},
{id:'cafe',n:'카페 스터디 세트',p:8000,s:2,k:'선택'},{id:'chk',n:'팀 치킨 회식',p:25000,s:4,k:'선택'},SAVE],
2:[{id:'del',n:'야식 배달',p:12000,s:3,k:'선택'},{id:'stu',n:'스터디카페 이용권',p:15000,s:3,k:'선택'},SAVE],
3:[{id:'trip',n:'졸업 여행(당일)',p:40000,s:5,k:'선택'},{id:'con',n:'콘서트·전시 관람',p:30000,s:4,k:'선택'},{id:'gift',n:'친구 생일 선물',p:15000,s:3,k:'선택'},SAVE]};
const PH={1:['settle','event','mission','shop'],2:['settle','mission','event','shop'],3:['settle','event','mission','shop']};
const MQ={
1:[{q:'월세, 교통비, 구독료, 간식 중 고정 지출은 무엇일까요?',o:['월세·교통비·구독료','월세·간식','교통비·간식','간식·구독료'],ok:[0],r:5000,ex:'매달 정해져서 나가는 돈이 고정 지출이에요. 간식은 그때그때 달라지는 변동 지출입니다.'},
{q:'30,000원짜리 상품을 20% 할인받으면 실제 지불 금액은?',o:['21,000원','24,000원','26,000원','27,000원'],ok:[1],r:5000,ex:'30,000 × 0.8 = 24,000원이에요.'}],
2:[{q:'택배 안내 문자가 왔어요. “배송지 확인 필요, 아래 링크를 눌러 주세요.” 가장 알맞은 대처는?',o:['링크를 눌러 주소를 입력한다','공식 택배 앱에서 직접 확인한다','번호를 차단하고 신고한다'],ok:[1,2],r:5000,p:-10000,ex:'긴급함이나 혜택을 내세워 링크를 누르게 하는 문자는 의심하세요. 링크 대신 공식 앱이나 고객센터에서 확인하는 게 안전합니다.'}]};
const W3=[['남은 고정·돌발 지출을 먼저 계산한다',1],['더 저렴한 대안이 있는지 찾아본다',1],['비상금·저축을 남겨 둘지 따져 본다',1],['친구들이 다 가니까 일단 간다',0],['지금은 돈이 없으니 나중에 갚기로 한다',0]];

let G;
const fmt=n=>(n<0?'−':'')+Math.abs(n).toLocaleString('ko-KR')+'원';
const sg=n=>(n>0?'+':'')+fmt(n);
const pick=a=>a[Math.floor(Math.random()*a.length)];
const $=document.getElementById('app');
function toast(m){let t=document.getElementById('toast');if(t)t.remove();t=document.createElement('div');t.id='toast';t.textContent=m;document.body.appendChild(t);setTimeout(()=>t.remove(),2600)}
function lg(l,a){G.log.push([G.week,l,a])}
function newGame(){G={stage:'intro',week:1,phase:0,money:100000,sat:0,sit:null,ch:null,team:0,sub:false,subPaid:0,subFree:false,armed:null,used:false,waive:0,savings:[],bought:{},items:[],log:[],qi:0,ans:null,m3:[],m3done:false,card:null,pending:null,paid:null,lapB:false,dv:null,rolling:false,flash:null,flashDone:false,fin:null,pledge:''};render()}

function hud(){
const c=G.ch,ab=G.used?'<button class="ab" disabled>특수 능력 사용 완료</button>':G.armed?'<button class="ab on" onclick="abil()">'+c.n+' 능력 발동 대기 중 · 누르면 취소</button>':'<button class="ab" onclick="abil()">특수 능력 사용 · '+c.n+' ('+c.d+')</button>';
return '<header><div class="wk">'+[1,2,3].map(w=>'<i class="'+(w<G.week?'d':w==G.week?'c':'')+'"></i>').join('')+'<span>'+G.week+'주 차</span></div><div class="sat">만족도 <b>'+G.sat+'</b></div><div class="bal"><small>통장 잔액</small><b class="'+(G.money<0?'neg':'')+'">'+fmt(G.money)+'</b></div><div></div>'+ab+'</header>'}

function abil(){
const t=G.ch.t;if(G.used)return;
if(G.armed){G.armed=null;return render()}
if(t=='s'){G.waive=30000;G.used=true;toast('앞으로의 돌발 지출에서 최대 30,000원이 면제돼요')}
else if(t=='g'){if(!G.sub)return toast('먼저 OTT 구독에 가입해야 쓸 수 있어요');G.subFree=true;G.used=true;const r=Math.min(G.subPaid,30000);G.money+=r;lg('한구독 구독료 면제',r);toast('구독료가 면제돼요')}
else{G.armed=t;toast('다음 '+(t=='b'?'QR 미션 성공':'소비')+'에 능력이 적용돼요')}
render()}

function render(){
let h='';
if(G.stage=='intro')h=intro();
else if(G.stage=='drawn')h=drawn();
else if(G.stage=='final')h=final();
else h=hud()+play();
$.innerHTML=h}

function intro(){return '<h1>파산을 피해라!<br>대학생 생존게임</h1><p class="big" style="font-size:20px">“개강 후 3주, 10만 원으로 살아남아라”</p>'+
'<div class="card"><p>통장에는 100,000원. 3주 동안 수입과 지출을 관리하고, 돌발 상황과 사기 문자를 넘기며 살아남으세요. 파산하면 학식도 못 먹어요.</p></div>'+
'<div class="card"><b>규칙 3가지</b><p>1. 고정 지출은 매주 정산 때 먼저 나가요.<br>2. 같은 주에 같은 항목은 한 번만 살 수 있고, 후불결제는 없어요.<br>3. 팀 캐릭터의 특수 능력은 3주 중 딱 1번만 써요.</p></div>'+
'<div class="card"><b>우리 팀 번호를 고르세요</b><p class="mute">팀 번호마다 캐릭터가 하나씩 정해져 있어서 팀끼리 겹치지 않아요. (4팀이면 1~4번만 사용)</p>'+[1,2,3,4,5].map(n=>'<button class="w ghost" onclick="draw('+n+')">'+n+'팀</button>').join('')+'</div>'}
function draw(n){G.team=n;const t=TEAMS[n-1];G.sit=t;G.ch=t.ab;G.stage='drawn';render()}
function drawn(){const s=G.sit,c=G.ch;return '<h2>'+G.team+'팀 캐릭터 카드</h2><div class="card"><span class="tag">팀 캐릭터</span><b>'+s.n+'</b><div class="row"><span>주당 수입</span><span>'+fmt(s.inc)+'</span></div><div class="row"><span>주당 고정 지출</span><span>'+fmt(s.fx)+'</span></div><div class="row"><span>난이도 가산점</span><span>만족도 +'+s.b+'</span></div><p class="mute">고정 지출: '+s.d+'</p></div>'+
'<div class="card"><span class="tag">특수 능력</span><b>'+c.n+'</b><p>'+c.d+'</p><p class="mute">모든 능력의 가치는 30,000원(≒ 만족도 5점)에 맞춰져 있어요.</p></div>'+
'<p class="mute">캐릭터와 상황은 가상의 설정이며 실제 나의 상황과 무관해요.</p><button class="w" onclick="G.stage=\'play\';render()">1주 차 시작</button><button class="w ghost" onclick="G.stage=\'intro\';render()">팀 다시 고르기</button>'}

function play(){
const p=PH[G.week][G.phase];
return {settle:settle,event:event,mission:mission,shop:shop}[p]()}
function adv(){G.phase++;G.qi=0;G.ans=null;G.m3=[];G.m3done=false;G.card=null;G.pending=null;G.paid=null;G.lapB=false;G.dv=null;G.flash=null;
if(G.phase>=PH[G.week].length)return endWeek();render();scrollTo(0,0)}

function settleCalc(){const s=G.sit,w=G.week;const inc=s.inc-(w==2?20000:0);const fee=(G.sub&&w>1&&!G.subFree)?10000:0;const mat=G.savings.filter(x=>x<w).length;return {inc,fx:s.fx,fee,mat,sat:(G.sub&&w>1)?1:0}}
function settle(){
const c=settleCalc(),net=c.inc-c.fx-c.fee+c.mat*11000;
return '<h2>'+G.week+'주 차 정산</h2>'+(G.week==2?'<p class="mute">시험 기간! 알바 수입이 줄었어요.</p>':'')+
'<div class="card"><div class="row"><span>수입'+(G.week==2?' (−20,000 반영)':'')+'</span><b class="pos">'+sg(c.inc)+'</b></div><div class="row"><span>고정 지출</span><b class="neg">'+sg(-c.fx)+'</b></div>'+
(G.sub&&G.week>1?'<div class="row"><span>OTT 구독료'+(G.subFree?' (면제)':'')+'</span><b class="neg">'+sg(-c.fee)+'</b></div>':'')+
(c.mat?'<div class="row"><span>비상금 환급 (이자 포함)</span><b class="pos">'+sg(c.mat*11000)+'</b></div>':'')+
'<div class="row"><span><b>이번 주 순수입</b></span><b class="'+(net<0?'neg':'pos')+'">'+sg(net)+'</b></div></div>'+
(G.sub&&G.week>1?'<button class="ghost w" onclick="G.sub=false;render()">OTT 구독 해지하기</button>':'')+
'<button class="w" onclick="doSettle()">정산 확정</button>'}
function doSettle(){const c=settleCalc();G.money+=c.inc-c.fx-c.fee+c.mat*11000;G.savings=G.savings.filter(x=>x>=G.week);G.sat+=c.sat;if(c.fee)G.subPaid+=c.fee;
lg('수입',c.inc);lg('고정 지출',-c.fx);if(c.fee)lg('구독료',-c.fee);if(c.mat)lg('비상금 환급',c.mat*11000);adv()}

function payView(){
const p=G.pending,w=Math.min(G.waive,p.cost);
return '<div class="card"><b>'+p.label+'</b><div class="row"><span>지출</span><b class="neg">'+fmt(-p.cost)+'</b></div>'+(w?'<div class="row"><span>능력으로 면제</span><b class="pos">+'+w.toLocaleString('ko-KR')+'원</b></div>':'')+
'<p class="mute">돌발 지출은 반드시 내야 해요.</p></div><button class="w" onclick="pay(0)">잔액에서 내기</button>'+(G.savings.length?'<button class="w ghost" onclick="pay(1)">비상금 인출해서 내기 (원금 10,000원 반환, 이자·만족도 없음)</button>':'')}
function pay(s){let c=G.pending.cost;const w=Math.min(G.waive,c);G.waive-=w;c-=w;if(s){G.savings.pop();G.money+=10000;G.sat-=1;lg('비상금 인출',10000)}G.money-=c;lg(G.pending.label,-c);G.paid={c,w};G.pending=null;render()}
function paidView(){return '<div class="card"><p>처리 완료: <b class="neg">'+fmt(-G.paid.c)+'</b>'+(G.paid.w?' (면제 '+G.paid.w.toLocaleString('ko-KR')+'원)':'')+'</p></div><button class="w" onclick="adv()">다음</button>'}

function event(){
if(G.week==2)return laptop();
let h='<h2>소소한 돌발</h2>';
if(!G.card)return h+'<p>살다 보면 돌발 상황이 생길 수 있어요.</p><button class="w" onclick="drawEv()">돌발 카드 뽑기</button>';
const c=G.card;h+='<div class="card"><b>'+c[1]+'</b><p class="'+(c[0]<0?'neg':c[0]>0?'pos':'')+'">'+(c[0]?sg(c[0]):'변동 없음')+'</p></div>';
if(G.pending)return h+payView();if(G.paid)return h+paidView();return h+'<button class="w" onclick="adv()">다음</button>'}
function drawEv(){const c=pick(EV);G.card=c;if(c[0]<0)G.pending={cost:-c[0],label:c[1]};else if(c[0]>0){G.money+=c[0];lg(c[1],c[0])}render()}

function laptop(){
let h='<h2>돌발 사건: 노트북 파손</h2>';
if(G.pending)return h+payView();if(G.paid)return h+paidView();
if(G.lapB){return h+'<div class="card"><p>선배에게 10,000원을 주고 맡겼어요. 주사위를 굴려요. 1~3이면 성공, 4~6이면 실패해서 추가 60,000원(총 70,000원)!</p><div class="die">'+(G.dv||'?')+'</div></div><button class="w" onclick="roll()" '+(G.rolling?'disabled':'')+'>주사위 굴리기</button>'}
return h+'<p>수리 방법을 골라요. 비상금과 최세이브 능력은 지불할 때 쓸 수 있어요.</p><button class="opt" onclick="lap(0)"><b>A. 공식 수리</b><br>40,000원 (확정)</button><button class="opt" onclick="lap(1)"><b>B. 선배 도움 수리</b><br>10,000원 + 주사위. 성공이면 그대로, 실패면 총 70,000원</button>'}
function lap(b){if(b){G.lapB=true}else G.pending={cost:40000,label:'노트북 공식 수리'};render()}
function roll(){G.rolling=true;let n=0;const iv=setInterval(()=>{G.dv=1+Math.floor(Math.random()*6);render();if(++n>9){clearInterval(iv);G.rolling=false;const ok=G.dv<=3;G.lapB=false;G.pending={cost:ok?10000:70000,label:'노트북 선배 수리 ('+(ok?'성공':'실패')+', 주사위 '+G.dv+')'};render()}},90)}

function mission(){
let h='<h2>QR 미션 '+G.week+'</h2>';
if(G.week==3)return h+m3();
const qs=MQ[G.week],q=qs[G.qi],a=G.ans;
h+='<div class="card"><p><b>'+q.q+'</b></p>'+q.o.map((o,i)=>'<button class="opt '+(a===null?'':q.ok.includes(i)?'ok':i==a?'no':'')+'" '+(a!==null?'disabled':'onclick="ans('+i+')"')+'>'+o+'</button>').join('')+'</div>';
if(a!==null){const g=q.ok.includes(a);h+='<div class="card"><b class="'+(g?'pos':'neg')+'">'+(g?'정답! '+sg(q.r):(q.p?'앗, 위험한 선택! '+sg(q.p):'아쉬워요'))+'</b><p>'+q.ex+'</p></div><button class="w" onclick="nextQ()">'+(G.qi+1<qs.length?'다음 문제':'미션 마치기')+'</button>'}
return h}
function ans(i){const q=MQ[G.week][G.qi];G.ans=i;
if(q.ok.includes(i)){G.money+=q.r;lg('미션 보너스',q.r);if(G.armed=='b'){G.money+=30000;G.used=true;G.armed=null;lg('박알바 능력',30000);toast('박알바 능력 발동! +30,000원')}}
else if(q.p){G.money+=q.p;lg('금융사기 링크 클릭',q.p)}
render()}
function nextQ(){const qs=MQ[G.week];if(G.qi+1<qs.length){G.qi++;G.ans=null;render()}else adv()}
function m3(){
const d=G.m3done;
let h='<div class="card"><p>잔액이 적은데 만족도가 높고 부담이 큰 소비(졸업 여행 등)를 앞두고 있어요. 고려할 점을 골라 보세요. (여러 개 선택)</p>'+W3.map((o,i)=>'<button class="opt '+(d?(o[1]?'ok':G.m3.includes(i)?'no':''):G.m3.includes(i)?'sel':'')+'" '+(d?'disabled':'onclick="tg('+i+')"')+'>'+o[0]+'</button>').join('')+'</div>';
if(!d)return h+'<button class="w" onclick="sub3()" '+(G.m3.length?'':'disabled')+'>제출하기</button>';
const good=G.m3.filter(i=>W3[i][1]).length>=2&&!G.m3.some(i=>!W3[i][1]);
return h+'<div class="card"><b class="'+(good?'pos':'')+'">'+(good?'타당한 근거예요! +3,000원':'근거를 더 따져 보면 좋았어요.')+'</b><p>남은 지출, 대안, 저축 여부를 함께 보는 게 핵심이에요.</p></div><button class="w" onclick="adv()">마지막 소비로</button>'}
function tg(i){const k=G.m3.indexOf(i);k<0?G.m3.push(i):G.m3.splice(k,1);render()}
function sub3(){G.m3done=true;const good=G.m3.filter(i=>W3[i][1]).length>=2&&!G.m3.some(i=>!W3[i][1]);if(good){G.money+=3000;lg('미션 보너스',3000);if(G.armed=='b'){G.money+=30000;G.used=true;G.armed=null;lg('박알바 능력',30000)}}render()}

function shop(){
const its=ITEMS[G.week];let h='<h2>소비 선택</h2>';
if(G.money<0)h+='<div class="card"><b class="neg">잔액이 마이너스예요.</b><p>이번 주는 소비할 수 없어요.</p></div>';
else h+='<p class="mute">후불결제는 없어요. 잔액이 모자라면 살 수 없어요.'+(G.armed&&G.armed!='b'?' <b>능력이 다음 소비에 적용돼요.</b>':'')+'</p>';
h+='<div class="card">'+its.map(it=>{const k=G.week+':'+(it.g||it.id),done=G.bought[k],dis=done||G.money<0;
return '<div class="row"><div><span class="tag">'+(it.k=='필수'?'○ 필수':'△ 선택')+'</span><b>'+it.n+'</b><div class="mute">'+fmt(it.p)+' · 만족도 +'+it.s+(it.note?'<br>'+it.note:'')+'</div></div><button '+(dis?'disabled':'onclick="buy(\''+it.id+'\')"')+'>'+(done?'구매함':'사기')+'</button></div>'}).join('')+'</div>';
if(G.week==2){
if(G.flash&&G.flash>Date.now())h+='<div class="card" style="border-color:var(--bad)"><b>한정특가! 충동구매 (30초 한정)</b><div class="mute">20,000원 · 만족도 +5 · 후회 스티커 대상</div><div class="bar" style="margin:8px 0"><i id="fb" style="width:100%"></i></div><button class="w" onclick="buy(\'imp\')">지금 사기</button></div>';
else if(!G.flashDone)h+='<button class="w ghost" onclick="startFlash()">진행자 신호: 한정특가 발동</button>'}
const need=G.week==1&&!G.bought['1:book'];
return h+'<button class="w" onclick="endWeek()" '+(need?'disabled':'')+'>'+(need?'전공 교재는 꼭 사야 해요':(G.week==3?'최종 정산하기':'이번 주 마무리'))+'</button>'}
function startFlash(){G.flash=Date.now()+30000;G.flashDone=true;render();const iv=setInterval(()=>{const f=document.getElementById('fb'),l=G.flash-Date.now();if(!f||l<=0){clearInterval(iv);if(G.flash&&l<=0){G.flash=null;toast('한정특가가 끝났어요');render()}return}f.style.width=(l/300)+'%'},100)}
function buy(id){
let it=id=='imp'?{id:'imp',n:'한정특가 충동구매',p:20000,s:5,k:'선택'}:ITEMS[G.week].find(x=>x.id==id);
const k=G.week+':'+(it.g||it.id);if(G.bought[k])return;
let p=it.p,s=it.s;
if(G.armed=='d'){p-=Math.min(30000,p)}
if(G.money<p)return toast('잔액이 부족해요 (후불결제 없음)');
if(G.armed=='d'||G.armed=='f'){if(G.armed=='f')s+=5;G.armed=null;G.used=true;toast(G.ch.n+' 능력 발동!')}
G.money-=p;G.sat+=s;G.bought[k]=1;G.items.push({n:it.n,p,s,w:G.week,r:id=='imp'});lg(it.n,-p);
if(id=='ott'){G.sub=true;G.subPaid+=p}
if(id=='save')G.savings.push(G.week);
if(id=='imp')G.flash=null;
render()}
function endWeek(){
if(G.week==3){const m=G.savings.length*11000;if(m){G.money+=m;lg('비상금 환급',m)}G.stage='final';G.fin=1;render();scrollTo(0,0);return}
G.week++;G.phase=0;G.qi=0;G.ans=null;G.flash=null;G.flashDone=false;render();scrollTo(0,0)}

function final(){
const ok=G.money>=0,ts=G.sat+G.sit.b,rg=G.items.filter(i=>i.r).length;
return '<h1>최종 정산</h1><div class="card" style="text-align:center"><span class="stamp '+(ok?'ok':'')+'">'+(ok?'생존!':'파산')+'</span>'+
'<p class="big" style="font-size:36px;margin:14px 0 0" >'+fmt(G.money)+'</p><p class="mute">최종 잔액</p></div>'+
'<div class="card"><div class="row"><span>구매 항목 만족도</span><b>'+G.sat+'</b></div><div class="row"><span>난이도 가산점 ('+G.sit.n+')</span><b>+'+G.sit.b+'</b></div><div class="row"><span><b>최종 만족도</b></span><b>'+ts+'</b></div></div>'+
(ok?'':'<div class="card"><b>위기 탈출 인터뷰</b><p>어디서 무너졌나요? 다음엔 어떻게 할까요? 파산은 실패가 아니라 배움의 재료예요.</p></div>')+
'<h2>후회 스티커</h2><p class="mute">후회된 소비를 눌러 표시해 보세요. (스티커 '+rg+'개)</p><div class="card">'+(G.items.length?G.items.map((it,i)=>'<div class="row"><span>'+it.w+'주 · '+it.n+'<div class="mute">'+fmt(-it.p)+' · 만족도 +'+it.s+'</div></span><button class="'+(it.r?'':'ghost')+'" onclick="G.items['+i+'].r=!G.items['+i+'].r;render()">'+(it.r?'후회됨':'만족')+'</button></div>').join(''):'<p class="mute">구매한 항목이 없어요.</p>')+'</div>'+
'<div class="card"><b>시상 판정 기록 ('+G.team+'팀)</b><div class="row"><span>최종 잔액</span><b>'+fmt(G.money)+'</b></div><div class="row"><span>최종 만족도</span><b>'+ts+'</b></div><div class="row"><span>후회 스티커</span><b>'+rg+'개</b></div><p class="mute">이 화면을 진행자에게 보여 주세요. ①우승 ②알뜰상 ③반전상은 정산 직후, ④후회 없는 소비상 ⑤베스트 팀워크상은 소감 나누기 중간에 발표해요. 1팀 1상 원칙이라 모든 팀이 상을 받아요.</p></div>'+
'<h2>다짐 카드</h2><textarea id="pl" rows="2" placeholder="내가 바꿀 소비 습관 한 줄" oninput="G.pledge=this.value">'+G.pledge.replace(/</g,'&lt;')+'</textarea>'+
'<details class="card"><summary><b>정산표 보기</b></summary>'+G.log.map(l=>'<div class="row"><span>'+l[0]+'주 · '+l[1]+'</span><span class="'+(l[2]<0?'neg':'pos')+'">'+sg(l[2])+'</span></div>').join('')+'</details>'+
'<p class="mute" style="text-align:center">얼마나 많이 소비했는가보다, 주어진 자금 안에서 얼마나 현명하게 선택했는가가 중요해요.</p><button class="w" onclick="newGame()">다시 하기</button>'}
newGame();
</script>
</body>
</html>
